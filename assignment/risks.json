/* ==========================================================================
   GRC & AI Governance Control Hub - styles.css
   Scaffold created as a starting point. Cite in line with the assignment brief and your university's
   academic integrity policy. Extend and adapt this -

   STRUCTURE (mobile-first - base styles target small screens; media
   queries at the bottom enhance for larger screens):
     1. Design tokens (CSS custom properties)
     2. Base / reset
     3. Prototype banner
     4. Header and navigation
     5. Layout helpers
     6. Cards and dashboard
     7. Status badges
     8. Tables
     9. Forms
    10. Footer
    11. Media queries (min-width - the mobile-first paradigm)
   ========================================================================== */

/* 1. DESIGN TOKENS ---------------------------------------------------------
   Custom properties keep the colour/typography scheme consistent and easy
   to change (Assessment 3 talking point: alternatives would be repeating
   hex values everywhere, or a preprocessor variable like Sass $vars). */
:root {
  /* Colour scheme - modelled on the visual language of industrial-sector
     cybersecurity portals (white header, warm off-white surfaces, deep
     maroon-red interactive accent, crimson-to-orange gradient reserved
     for brand marks). Original values; no proprietary assets. */
  --colour-ink: #2d2a26;        /* charcoal: body headings, header brand */
  --colour-body: #4a4642;       /* body text */
  --colour-surface: #f7f4f2;    /* warm off-white page background */
  --colour-card: #ffffff;       /* card / panel background */
  --colour-line: #e4deda;       /* borders and dividers */
  --colour-accent: #a6192e;     /* deep maroon-red: links, buttons, focus */
  --colour-accent-dark: #7e1322;

  /* Brand gradient colours (used by the logo and hero banner).
     ASSESSMENT 3 TALKING POINT: the brand accent is red, but in a GRC
     tool red also means "high risk". Resolved by role separation -
     interactive red appears as SOLID buttons/links in deep maroon,
     while risk status appears as OUTLINE pill badges that always carry
     a text label (WCAG 1.4.1), in a visibly brighter red. Shape + label
     carry the meaning, not hue alone. */
  --brand-red: #CD163F;
  --brand-orange: #F58025;

  /* Status colours (RAG). Chosen for WCAG AA contrast on white.
     Accessibility note: status is NEVER conveyed by colour alone -
     badges always include a text label (WCAG 1.4.1 Use of Colour). */
  --status-green: #067647;
  --status-amber: #92400e;
  --status-red: #b42318;

  /* Typography */
  --font-body: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "Courier New", monospace;

  /* Spacing scale */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 1rem;
  --space-4: 1.5rem;
  --space-5: 2.5rem;

  --radius: 8px;
}

/* 2. BASE / RESET ---------------------------------------------------------- */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--colour-body);
  background-color: var(--colour-surface);
}

h1, h2, h3 {
  color: var(--colour-ink);
  line-height: 1.2;
  margin-top: 0;
}

/* Top-level headings pick up the maroon accent, echoing the portal
   style where page/section titles are brand-red and subheadings stay
   charcoal. Contrast of #7e1322 on white: ~10:1 (WCAG AAA). */
h1 { font-size: 1.6rem; font-weight: 700; color: var(--colour-accent-dark); }
h2 { font-size: 1.25rem; }
h3 { font-size: 1.05rem; }

a {
  color: var(--colour-accent);
}

/* Pseudo-class selectors (rubric: pseudo-classes) */
a:hover {
  color: var(--colour-accent-dark);
}

/* Visible keyboard focus for ALL interactive elements
   (WCAG 2.4.7 Focus Visible) */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid var(--colour-accent);
  outline-offset: 2px;
}

img {
  max-width: 100%;
  height: auto;
}

/* Respect users who prefer reduced motion (WCAG 2.3.3) */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* 3. PROTOTYPE BANNER -------------------------------------------------------
   Signature element: a permanent banner making the academic, synthetic
   nature of the data visible on every page (matches the scope brief). */
.prototype-banner {
  background-color: var(--colour-accent);
  color: #ffffff;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
  padding: var(--space-1) var(--space-3);
}

/* 4. HEADER AND NAVIGATION --------------------------------------------------
   Mobile-first: nav is hidden behind a toggle button on small screens.
   The desktop media query at the bottom shows it as a horizontal bar. */
.site-header {
  background-color: var(--colour-card);
  border-bottom: 1px solid var(--colour-line);
  padding: var(--space-2) var(--space-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.site-header .brand {
  font-weight: 700;
  color: var(--colour-ink);
  text-decoration: none;
  font-size: 1.05rem;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.site-header .brand img {
  display: block;
}

.nav-toggle {
  background: none;
  border: 2px solid var(--colour-line);
  border-radius: var(--radius);
  padding: var(--space-1) var(--space-2);
  font: inherit;
  cursor: pointer;
  color: var(--colour-ink);
}

.site-nav {
  width: 100%;
}

.site-nav--enhanced {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-0.35rem);
  transition: max-height 280ms ease, opacity 200ms ease, transform 200ms ease;
}

.site-nav--enhanced.site-nav--open {
  max-height: 24rem;
  opacity: 1;
  transform: translateY(0);
}

.site-nav ul {
  list-style: none;
  margin: var(--space-2) 0 0;
  padding: 0;
}

.site-nav a {
  display: block;
  padding: var(--space-2);
  text-decoration: none;
  color: var(--colour-ink);
  border-radius: var(--radius);
}

.site-nav a:hover {
  background-color: var(--colour-surface);
}

/* Attribute selector (rubric: attribute selectors — distinction band).
   Highlights the current page's nav link, set via aria-current in HTML,
   which also announces "current page" to screen readers. */
.site-nav a[aria-current="page"] {
  background-color: var(--colour-accent);
  color: #ffffff;
}

/* 5. LAYOUT HELPERS --------------------------------------------------------- */
.container {
  padding: var(--space-3);
  max-width: 72rem;
  margin: 0 auto;
}

/* Red gradient hero band, echoing the portal's page banners, with a
   decorative network-mesh background layered on top (first background
   layer renders above the gradient). The mesh is white at ~12% opacity,
   so white text contrast is unaffected (WCAG 1.4.3), and being a CSS
   background it is ignored by screen readers - decorative by design
   (an Assessment 3 accessibility point: decoration belongs in CSS, not
   in <img> tags needing alt text). Swap bg-hero-mesh.svg for
   bg-hero-circuit.svg for a circuit-trace look. */
.page-intro {
  margin-bottom: var(--space-4);
  background:
    url("../images/bg-hero-mesh.svg") right center / cover no-repeat,
    linear-gradient(100deg, var(--colour-accent-dark), #c0143c);
  border-bottom: 4px solid var(--brand-orange);
  border-radius: var(--radius);
  padding: var(--space-4) var(--space-3);
}

.page-intro h1,
.page-intro p {
  color: #ffffff;
}

.page-intro p {
  margin-bottom: 0;
  max-width: 60ch;
}

/* Hero variant for AI governance pages: a stylised neural network with
   one ringed "human oversight" node — same low-opacity white rules as
   the mesh, so contrast is unaffected. Applied via a modifier class
   (BEM-style), itself a CSS talking point. */
.page-intro--ai {
  background:
    url("../images/bg-hero-neural.svg") right center / cover no-repeat,
    linear-gradient(100deg, var(--colour-accent-dark), #c0143c);
}

/* OPTIONAL page texture: whisper-volume hexagon grid on the page
   background (echoes the logo shape). Uncomment to try it; leave off if
   it competes with content — restraint is a defensible design choice.
body {
  background-image: url("images/bg-hexgrid.svg");
}
*/

/* 6. CARDS AND DASHBOARD ----------------------------------------------------
   Single column on mobile; the media query switches to CSS Grid. */
.card-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
}

.card {
  background-color: var(--colour-card);
  border: 1px solid var(--colour-line);
  border-radius: var(--radius);
  padding: var(--space-3);
}

.card .metric {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--colour-accent-dark);
  display: block;
}

.card .metric-label {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Monospace treatment for register-style identifiers (control IDs,
   CVE IDs, use-case refs) — part of the visual signature. */
.ref-id {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background-color: var(--colour-surface);
  padding: 0 var(--space-1);
  border-radius: 4px;
}

/* 7. STATUS BADGES -----------------------------------------------------------
   Class selectors with BEM-style modifiers (rubric: classes).
   Text label + colour, never colour alone (WCAG 1.4.1). */
.badge {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 0.1rem 0.6rem;
  border-radius: 999px;
  border: 1.5px solid currentColor;
}

.badge--ok    { color: var(--status-green); }
.badge--warn  { color: var(--status-amber); }
.badge--risk  { color: var(--status-red); }

/* 8. TABLES ------------------------------------------------------------------ */
.data-table {
  width: 100%;
  border-collapse: collapse;
  background-color: var(--colour-card);
  border: 1px solid var(--colour-line);
  border-radius: var(--radius);
  font-size: 0.92rem;
}

.data-table caption {
  text-align: left;
  font-weight: 600;
  color: var(--colour-ink);
  padding: var(--space-2) 0;
}

.data-table th,
.data-table td {
  text-align: left;
  padding: var(--space-2);
  border-bottom: 1px solid var(--colour-line);
}

.data-table th {
  background-color: var(--colour-surface);
  color: var(--colour-ink);
}

/* Structural pseudo-class (rubric: pseudo-classes): zebra striping */
.data-table tbody tr:nth-child(even) {
  background-color: #faf7f5;
}

.data-table tbody tr:hover {
  background-color: #f6ecea;
}

/* 9. FORMS --------------------------------------------------------------------
   Element + attribute selectors together. */
form {
  background-color: var(--colour-card);
  border: 1px solid var(--colour-line);
  border-radius: var(--radius);
  padding: var(--space-3);
}

fieldset {
  border: 1px solid var(--colour-line);
  border-radius: var(--radius);
  margin: 0 0 var(--space-3);
  padding: var(--space-3);
}

legend {
  font-weight: 600;
  color: var(--colour-ink);
  padding: 0 var(--space-1);
}

label {
  display: block;
  font-weight: 600;
  color: var(--colour-ink);
  margin-bottom: var(--space-1);
}

/* Attribute selectors target inputs by type without extra classes
   (rubric: attribute selectors) */
input[type="text"],
input[type="email"],
input[type="date"],
select,
textarea {
  width: 100%;
  font: inherit;
  color: inherit;
  padding: var(--space-2);
  border: 1.5px solid var(--colour-line);
  border-radius: var(--radius);
  background-color: #ffffff;
  margin-bottom: var(--space-3);
}

/* UI pseudo-classes give live validation feedback with no JavaScript
   (Assessment 3 talking point alongside your JS validation).
   :user-invalid only flags fields after interaction — friendlier than
   :invalid, which flags empty required fields on page load. */
input:user-invalid,
select:user-invalid,
textarea:user-invalid {
  border-color: var(--status-red);
}

.radio-option,
.checkbox-option {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

/* Labels inside radio/checkbox rows sit inline, not as block headings */
.radio-option label,
.checkbox-option label {
  font-weight: 400;
  margin-bottom: 0;
}

button[type="submit"] {
  font: inherit;
  font-weight: 600;
  color: #ffffff;
  background-color: var(--colour-accent);
  border: none;
  border-radius: var(--radius);
  padding: var(--space-2) var(--space-4);
  cursor: pointer;
}

button[type="submit"]:hover {
  background-color: var(--colour-accent-dark);
}

.form-hint {
  font-size: 0.85rem;
  margin-top: calc(-1 * var(--space-2));
  margin-bottom: var(--space-3);
}

/* Region JS writes API results / form feedback into. aria-live in the
   HTML means screen readers announce updates (WCAG 4.1.3). */
.results-region:not(:empty) {
  margin-top: var(--space-3);
  padding: var(--space-3);
  background-color: var(--colour-card);
  border: 1px solid var(--colour-line);
  border-left: 4px solid var(--colour-accent);
  border-radius: var(--radius);
}

/* 10. FOOTER ------------------------------------------------------------------ */
.site-footer {
  margin-top: var(--space-5);
  padding: var(--space-3);
  border-top: 1px solid var(--colour-line);
  font-size: 0.85rem;
  text-align: center;
}

/* 11. MEDIA QUERIES — MOBILE FIRST ---------------------------------------------
   Everything above styles the small-screen experience. These min-width
   queries progressively enhance for larger screens (never max-width
   overrides — that would be desktop-first). */
@media (min-width: 40em) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 60em) {
  h1 { font-size: 2rem; }

  /* Nav becomes a persistent horizontal bar; toggle button hides */
  .nav-toggle {
    display: none;
  }

  .site-nav {
    width: auto;
  }

  /* Overrides the hidden attribute JS uses on mobile */
  .site-nav[hidden] {
    display: block;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
  }

  .card-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .container {
    padding: var(--space-4);
  }
}


/* Dynamic content and validation feedback */
.empty-state { text-align: center; font-style: italic; }
.results-region { margin: var(--space-3) 0; }
.error-message { color: var(--status-red); font-weight: 600; }
.success-message { color: var(--status-green); font-weight: 600; }
.result-card, .usecase-card {
  background: var(--colour-card);
  border: 1px solid var(--colour-line);
  border-radius: var(--radius);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
}
#usecase-list { list-style: none; padding: 0; }
.result-details { display: grid; grid-template-columns: minmax(10rem, 1fr) 2fr; gap: var(--space-1) var(--space-3); }
.result-details dt { font-weight: 700; color: var(--colour-ink); }
.result-details dd { margin: 0; }

@media (min-width: 60em) {
  .site-nav--enhanced {
    max-height: none;
    overflow: visible;
    opacity: 1;
    transform: none;
    transition: none;
  }
}
